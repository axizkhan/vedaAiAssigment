<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>{{examTitle}}</title>
  <style>
    /* Injected Print Styles via Puppeteer Renderer */
    {{{injectedStyles}}}
  </style>
</head>
<body>
  <div class="paper-container">
    {{> header this}}
    
    {{#if instructions}}
    <div class="instructions avoid-page-break margin-large">
      <h3 class="section-title">Instructions</h3>
      <p>{{{instructions}}}</p>
    </div>
    {{/if}}

    <div class="sections">
      {{#each sections}}
        {{> section this}}
      {{/each}}
    </div>
    
    {{> footer this}}
  </div>
</body>
</html>
